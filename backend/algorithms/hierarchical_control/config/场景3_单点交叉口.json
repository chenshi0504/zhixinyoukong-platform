{
  "scenario": "三层级全协同-单点交叉口",
  "network_type": "single_intersection",
  "algorithms": {
    "upper": "MPC-TuRBO",
    "middle": "KSP+MSA",
    "lower": "MPC-TuRBO"
  },
  "coordination": {
    "mode": "fully_integrated",
    "update_sequence": [
      "upper",
      "middle",
      "lower"
    ],
    "iteration_interval": 60,
    "convergence_criterion": 0.005
