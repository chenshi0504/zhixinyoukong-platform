<Folder><name>Link Layer</name> 
<Schema name="link" id="link">
<SimpleField name="Description" type="string"></SimpleField>
<SimpleField name="Name" type="string"></SimpleField>
<SimpleField name="from_node_id" type="int"></SimpleField>
<SimpleField name="to_node_id" type="int"></SimpleField>
<SimpleField name="link_id" type="int"></SimpleField>
<SimpleField name="link_length" type="float"></SimpleField>
<SimpleField name="number_of_lanes" type="int"></SimpleField>
<SimpleField name="speed_limit_mph" type="float"></SimpleField>
<SimpleField name="capacity_per_lane_per_hour" type="float"></SimpleField>
<SimpleField name="capacity_per_link_per_hour" type="float"></SimpleField>
<SimpleField name="free_flow_travel_time_(min)" type="float"></SimpleField>
</Schema>
<Placemark id="Link1">
