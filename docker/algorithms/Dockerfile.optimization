# 三层级协同优化算法后端
FROM python:3.12-slim

WORKDIR /app

# 安装系统依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# 复制算法代码
COPY backend/algorithms/三层级优化/ /app/

# 安装Python依赖
RUN pip install --no-cache-dir numpy pandas matplotlib openpyxl

EXPOSE 5003

CMD ["python", "backend_server.py"]
