# ---------- 数据库 ----------
DATABASE_URL=postgresql://clouduser:CHANGE_ME@db:5432/clouddb
POSTGRES_DB=clouddb
POSTGRES_USER=clouduser
POSTGRES_PASSWORD=CHANGE_ME

# ---------- 安全 ----------
# 生产环境请用随机长串：python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_48_BYTES
# 允许跨域的前端地址，多个用逗号分隔
ALLOWED_ORIGINS=https://your-name.github.io,http://localhost:5173

# ---------- 上传 ----------
UPLOAD_DIR=/data/uploads

# ---------- 前端构建变量（cloud/frontend/.env.production） ----------
VITE_API_BASE=https://your-api.onrender.com
